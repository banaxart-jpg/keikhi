// Firestore セキュリティルール (Firebase project: keikhi)。
// 認証済みユーザーが「自分の uid のドキュメント」だけ読み書きできるパターン。
// 今のところランチャー設定 (launcher_prefs) のみここに置く。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ランチャーのタイル並び/非表示 (Firebase Auth uid で識別)
    match /launcher_prefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCM (Web Push) device tokens: 各ユーザーは自分のサブコレクションのみ
    // 読み書きできる。サーバ (firebase-admin) はルールをバイパスして全部読める。
    match /fcm_tokens/{uid}/devices/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 手配リスト (現場ごとの共有 工具・材料 メモ): サインインしてれば誰でも。
    // 全員が全アイテム読み書き可。書き込み時刻 / 投稿者 はサーバ無しで
    // ドキュメント内に持つ。
    match /shopping_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    // それ以外は禁止 (明示)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
