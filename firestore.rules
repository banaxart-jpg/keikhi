// Firestore セキュリティルール (Firebase project: keikhi)。
// 認証済みユーザーが「自分の uid のドキュメント」だけ読み書きできるパターン。
// 今のところランチャー設定 (launcher_prefs) のみここに置く。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ランチャーのタイル並び/非表示 (Firebase Auth uid で識別)
    match /launcher_prefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCM (Web Push) device tokens: 各ユーザーは自分のサブコレクションのみ
    // 読み書きできる。サーバ (firebase-admin) はルールをバイパスして全部読める。
    match /fcm_tokens/{uid}/devices/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 手配リスト (現場ごとの共有 工具・材料 メモ): サインインしてれば誰でも。
    // 全員が全アイテム読み書き可。書き込み時刻 / 投稿者 はサーバ無しで
    // ドキュメント内に持つ。
    match /shopping_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    // 固定費マスタ (会社共通の毎月の固定支出テンプレ): 認証済みなら全員可。
    // 月次の送信履歴 (二重送信防止用) も同様。
    match /koteihi_items/{itemId} {
      allow read, write: if request.auth != null;
    }
    match /koteihi_sent/{yyyymm} {
      allow read, write: if request.auth != null;
    }
    // 初回 seed 済みフラグ。最初の認証ユーザーが書き込み、以降は読みのみ実質的に使う。
    match /koteihi_meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // 宿 (yado) 戦略タブの貼り付けレビュー。チャネル別テキストを 1 ドキュメントに保存。
    match /yado_reviews/{docId} {
      allow read, write: if request.auth != null;
    }

    // タスク: 社内 3 アカウント限定 (小西・名取・banaxart)。
    // Cloud SQL の tasks テーブルから Firestore へ移行 (realtime 同期 + 現場分け対応)。
    match /tasks/{taskId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'info@banax.tokyo',
          'konishi0221@gmail.com',
          'banaxart@gmail.com'
        ];
    }

    // 請求書 (seikyu): 社内 3 アカウント限定。localStorage → Firestore に移行して
    // PC ↔ スマホ ↔ ユーザー間で realtime 同期。
    match /seikyu_invoices/{invoiceId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'info@banax.tokyo',
          'konishi0221@gmail.com',
          'banaxart@gmail.com'
        ];
    }

    // それ以外は禁止 (明示)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
