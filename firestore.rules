// Firestore セキュリティルール (Firebase project: keikhi)。
// 認証済みユーザーが「自分の uid のドキュメント」だけ読み書きできるパターン。
// 今のところランチャー設定 (launcher_prefs) のみここに置く。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ランチャーのタイル並び/非表示 (Firebase Auth uid で識別)
    match /launcher_prefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCM (Web Push) device tokens: 各ユーザーは自分のサブコレクションのみ
    // 読み書きできる。サーバ (firebase-admin) はルールをバイパスして全部読める。
    match /fcm_tokens/{uid}/devices/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 手配リスト (現場ごとの共有 工具・材料 メモ): サインインしてれば誰でも。
    // 全員が全アイテム読み書き可。書き込み時刻 / 投稿者 はサーバ無しで
    // ドキュメント内に持つ。
    match /shopping_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    // 固定費マスタ (会社共通の毎月の固定支出テンプレ): 認証済みなら全員可。
    // 月次の送信履歴 (二重送信防止用) も同様。
    match /koteihi_items/{itemId} {
      allow read, write: if request.auth != null;
    }
    match /koteihi_sent/{yyyymm} {
      allow read, write: if request.auth != null;
    }
    // 初回 seed 済みフラグ。最初の認証ユーザーが書き込み、以降は読みのみ実質的に使う。
    match /koteihi_meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // 宿 (yado) 戦略タブの貼り付けレビュー。チャネル別テキストを 1 ドキュメントに保存。
    match /yado_reviews/{docId} {
      allow read, write: if request.auth != null;
    }

    // 宿 (yado) やることリスト。改善アイデア/todo を 1 ドキュメントに保存。
    match /yado_tasks/{docId} {
      allow read, write: if request.auth != null;
    }

    // タスク: 手配リスト (shopping_items) と同じく、認証済みなら社外含む全員。
    // (社内 3 アカ限定 → 認証ユーザー全員 に緩和。
    //  外部協力者がタスクを引き受けるようなフローにも使うため。)
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // 請求書 (seikyu): 手配リスト (shopping_items) / タスク と同じく、認証済みなら全員が
    // 読み書き可 (社外協力者含む) に緩和。localStorage → Firestore で PC ↔ スマホ ↔
    // ユーザー間で realtime 同期。
    // (旧: 社内 3 アカウント email 限定 → 全員が登録した請求書を共有したいため緩和)
    match /seikyu_invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }

    // 現場メモ: 社内 3 アカウント限定。ユーザーごとに sub-collection で隔離して
    //   genba_memos/{uid}/memos/{memoId} に保存。memoId = `<site>__<YYYY-MM-DD>`。
    // 各自は自分の {uid} 配下しか読み書きできない (= 名取↔小西 互いに見えない)。
    match /genba_memos/{uid}/memos/{memoId} {
      allow read, write: if request.auth != null
        && uid == request.auth.uid
        && request.auth.token.email in [
          'info@banax.tokyo',
          'konishi0221@gmail.com',
          'banaxart@gmail.com'
        ];
    }

    // 菌学クイズ (fungi) の個人成績 (累計セッション数 / 正答率 / 各問題の試行回数)。
    // ユーザーごとに自分のドキュメントしか読み書きできない。
    match /fungi_progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // それ以外は禁止 (明示)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
